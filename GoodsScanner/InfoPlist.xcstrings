    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird zum Scannen von Artikelmaßen und für Wareneingangsfotos verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to scan item dimensions and take inbound photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para escanear las dimensiones de los artículos y hacer fotos de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert à scanner les dimensions des articles et à prendre les photos de réception."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "品目のサイズを測定し、入庫写真を撮影するために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "품목 크기를 스캔하고 입고 사진을 촬영하는 데 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usada para escanear as dimensões dos itens e tirar fotos de entrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для сканирования размеров товаров и фото при приёмке."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng để quét kích thước hàng hóa và chụp ảnh nhập kho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于扫描货物尺寸和拍摄入库照片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於掃描貨物尺寸及拍攝入庫照片。"
          }
        }
      }
    }
  },
  "version": "1.0"
