    "AR scanning isn't supported on this device. Enter the size by hand.": {
      "comment": "ItemEditView",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AR-Scan wird auf diesem Gerät nicht unterstützt. Maße manuell eingeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no admite el escaneo AR. Introduce el tamaño a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scan AR n’est pas pris en charge sur cet appareil. Saisissez la taille à la main."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは AR スキャンに対応していません。サイズを手動で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 AR 스캔을 지원하지 않습니다. 크기를 직접 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este aparelho não é compatível com escaneamento AR. Insira o tamanho manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AR-сканирование не поддерживается на этом устройстве. Введите размеры вручную."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này không hỗ trợ quét AR. Hãy nhập kích thước thủ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机不支持 AR 扫描，请手动录入尺寸"
