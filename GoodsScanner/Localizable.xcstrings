    "When goods arrive, create an inbound order, then scan or enter each item’s size.": {
      "comment": "OrdersView",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie bei Wareneingang einen Eintrag an und scannen Sie dann die Maße jedes Artikels oder geben Sie sie ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando llegue la mercancía, crea una orden de entrada y escanea o introduce el tamaño de cada artículo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’arrivée des marchandises, créez un bon de réception, puis scannez ou saisissez la taille de chaque article."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貨物が到着したら入庫伝票を作成し、各品目をスキャンするかサイズを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화물이 도착하면 입고 전표를 만든 다음, 품목별로 스캔하거나 크기를 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a mercadoria chegar, crie uma ordem de entrada e escaneie ou insira o tamanho de cada item."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При поступлении товара создайте приёмку, затем отсканируйте или введите размеры каждого товара."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi hàng về, hãy tạo phiếu nhập kho, rồi quét hoặc nhập kích thước của từng hàng hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "货物到仓后新建入库单，逐件扫描或录入尺寸"
