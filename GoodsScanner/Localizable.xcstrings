    "Length, width and height are calculated for you. Check them and adjust if needed.": {
      "comment": "OnboardingView",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Länge, Breite und Höhe werden für Sie berechnet. Prüfen Sie die Werte und passen Sie sie bei Bedarf an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El largo, ancho y alto se calculan automáticamente. Compruébalos y ajústalos si es necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La longueur, la largeur et la hauteur sont calculées pour vous. Vérifiez-les et ajustez si besoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長さ・幅・高さは自動で算出されます。確認して、必要に応じて調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길이, 너비, 높이는 자동으로 계산됩니다. 확인 후 필요하면 조정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprimento, largura e altura são calculados automaticamente. Confira e ajuste se necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длина, ширина и высота рассчитываются автоматически. Проверьте их и при необходимости исправьте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiều dài, chiều rộng và chiều cao được tính tự động. Hãy kiểm tra và điều chỉnh nếu cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长宽高会自动算出，请核对，必要时调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長、寬、高會自動算出，請核對，必要時再調整。"
          }
        }
      }
    },
