    "Circle the item slowly, keeping it in view, until every segment of the ring lights up.": {
      "comment": "OnboardingView",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umrunden Sie den Artikel langsam und halten Sie ihn im Bild, bis jedes Segment des Rings leuchtet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodea el objeto despacio, manteniéndolo a la vista, hasta que se ilumine cada segmento del anillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez lentement autour de l’objet, en le gardant dans le champ, jusqu’à ce que chaque segment de l’anneau s’allume."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象物を画面に収めたまま、リングのすべての区間が点灯するまでゆっくり一周してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물체가 화면에 계속 보이게 하면서, 링의 모든 구간이 켜질 때까지 천천히 한 바퀴 도세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contorne o objeto devagar, mantendo-o à vista, até que cada segmento do anel acenda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно обходите товар, не выпуская его из виду, пока не загорятся все сегменты кольца."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đi chậm quanh hàng hóa, giữ hàng hóa trong khung hình, cho đến khi mọi đoạn của vòng sáng lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持物体在画面内，绕它慢慢走一圈，直到圆环的每一段都亮起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持物件在畫面內，繞著它慢慢走一圈，直到圓環的每一段都亮起。"
          }
        }
      }
    },
