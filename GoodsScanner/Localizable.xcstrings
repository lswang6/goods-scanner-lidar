    "Accuracy is not guaranteed. It varies with the device, the object's shape and material, lighting, surroundings and scanning technique.": {
      "comment": "OnboardingView",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Genauigkeit wird nicht garantiert. Sie hängt vom Gerät, von Form und Material des Objekts, von Beleuchtung, Umgebung und Scantechnik ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La precisión no está garantizada. Varía según el dispositivo, la forma y el material del objeto, la iluminación, el entorno y la técnica de escaneo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La précision n’est pas garantie. Elle varie selon l’appareil, la forme et la matière de l’objet, l’éclairage, l’environnement et la technique de scan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定精度は保証されません。精度は、デバイス、対象物の形状や素材、照明、周囲の環境、スキャンの方法によって変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정 정확도는 보장되지 않습니다. 기기, 물체의 형태와 재질, 조명, 주변 환경, 스캔 방법에 따라 달라질 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A precisão não é garantida. Ela varia conforme o aparelho, o formato e o material do objeto, a iluminação, o ambiente e a técnica de escaneamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точность не гарантируется. Она зависит от устройства, формы и материала объекта, освещения, окружения и техники сканирования."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ chính xác không được đảm bảo. Kết quả thay đổi tùy theo thiết bị, hình dạng và chất liệu của vật thể, ánh sáng, môi trường xung quanh và kỹ thuật quét."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量精度无法保证，会因设备、物体形状与材质、光线、周围环境和扫描手法而异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法保證測量精度，會因裝置、物件形狀與材質、光線、周圍環境及掃描方式而異。"
          }
        }
      }
    },
