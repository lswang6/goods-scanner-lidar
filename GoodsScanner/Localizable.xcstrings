            "value": "入庫伝票に顧客を割り当てるには、先に顧客を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입고 전표에 고객을 지정하려면 먼저 고객을 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione clientes primeiro para poder atribuí-los às ordens de entrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавьте клиентов, чтобы привязывать их к приёмкам."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm khách hàng trước để gán vào các phiếu nhập kho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先建客户档案，入库单才能选择客户"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先建立客戶，才能在入庫單中指定客戶。"
          }
        }
      }
    },
    "Add items to inbound orders, then share reports as CSV or PDF.": {
