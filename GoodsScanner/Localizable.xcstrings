    "Verify critical dimensions with a tape measure before relying on them, for example for freight charges, packing or customs.": {
      "comment": "OnboardingView",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie kritische Maße mit einem Maßband nach, bevor Sie sich darauf verlassen, z. B. für Frachtkosten, Verpackung oder Zoll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica las dimensiones críticas con un metro antes de fiarte de ellas, por ejemplo para costes de flete, embalaje o aduanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les dimensions critiques avec un mètre ruban avant de vous y fier, par exemple pour le fret, l’emballage ou la douane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運賃、梱包、通関などに使用する重要な寸法は、利用前にメジャーで確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운임, 포장, 통관 등에 쓰는 중요한 치수는 줄자로 확인한 후에 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira as dimensões críticas com uma trena antes de confiar nelas, por exemplo para frete, embalagem ou alfândega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяйте важные размеры рулеткой, прежде чем полагаться на них, например при расчёте стоимости перевозки, упаковке или таможенном оформлении."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kiểm tra các kích thước quan trọng bằng thước cuộn trước khi dựa vào chúng, ví dụ để tính cước vận chuyển, đóng gói hoặc thông quan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关键尺寸（例如用于运费、装箱或报关）请先用卷尺核实。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關鍵尺寸（例如用於運費、包裝或報關）在採用前，請先以捲尺核實。"
          }
        }
      }
    },
