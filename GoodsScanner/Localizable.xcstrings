    "Measurements are estimates produced from your iPhone's sensors (LiDAR) or camera.": {
      "comment": "OnboardingView",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messwerte sind Schätzungen, die aus den Sensoren (LiDAR) oder der Kamera Ihres iPhone berechnet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mediciones son estimaciones obtenidas con los sensores (LiDAR) o la cámara de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures sont des estimations obtenues à partir des capteurs (LiDAR) ou de la caméra de votre iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定結果は、iPhone のセンサー（LiDAR）またはカメラから得られた推定値です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정값은 iPhone의 센서(LiDAR) 또는 카메라로 산출한 추정치입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As medições são estimativas obtidas pelos sensores (LiDAR) ou pela câmera do seu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты измерений являются оценками, полученными с помощью датчиков (LiDAR) или камеры вашего iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số đo là giá trị ước tính từ cảm biến (LiDAR) hoặc camera trên iPhone của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
