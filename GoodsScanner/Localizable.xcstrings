    "Allow camera access in Settings to measure items, or go back to enter the size by hand.": {
      "comment": "ScanView",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie den Kamerazugriff in den Einstellungen, um Artikel zu messen, oder gehen Sie zurück, um die Maße manuell einzugeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la cámara en Ajustes para medir artículos, o vuelve para introducir el tamaño a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à la caméra dans Réglages pour mesurer les articles, ou revenez en arrière pour saisir la taille à la main."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "荷物を測定するには「設定」でカメラへのアクセスを許可するか、戻ってサイズを手動で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화물을 측정하려면 설정에서 카메라 접근을 허용하거나, 돌아가서 크기를 직접 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à câmera em Ajustes para medir itens, ou volte para inserir o tamanho manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к камере в Настройках, чтобы измерять грузы, или вернитесь, чтобы ввести размеры вручную."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép truy cập camera trong Cài đặt để đo hàng, hoặc quay lại để nhập kích thước thủ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「设置」中允许访问相机以测量货物，或返回手动录入尺寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中允許取用相機以測量貨物，或返回手動輸入尺寸。"
          }
        }
      }
    },
