    "Move slowly, keep the item and its surroundings in view": {
      "comment": "ScanSession",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsam bewegen, Artikel und Umgebung im Bild halten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muévete despacio y mantén el objeto y su entorno a la vista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez-vous lentement, gardez l’objet et son environnement dans le champ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり動かし、対象物と周囲が画面に入るようにしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천천히 움직이며 물체와 주변이 화면에 보이게 하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova-se devagar, mantendo o objeto e o ambiente à vista"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигайтесь медленно, держите товар и его окружение в кадре"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuyển chậm, giữ hàng hóa và khu vực xung quanh trong khung hình"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓慢移动，保持物体和周围在画面内"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "緩慢移動，讓物件和周圍保持在畫面內"
          }
        }
      }
    },
