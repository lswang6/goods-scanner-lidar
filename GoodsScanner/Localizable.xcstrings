    "Lower the phone, face the sides and walk another half lap": {
      "comment": "ScanSession",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon senken, auf die Seiten zielen und noch eine halbe Runde gehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el teléfono, enfoca los laterales y da otra media vuelta"
