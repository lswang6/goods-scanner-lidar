    "Adjust the date or customer filter to see the summary and export.": {
      "comment": "ReportsView",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie den Datums- oder Kundenfilter an, um die Übersicht zu sehen und zu exportieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la fecha o el filtro de cliente para ver el resumen y exportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez la date ou le filtre client pour voir le récapitulatif et exporter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付または顧客の絞り込み条件を変更すると、集計とエクスポートを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜 또는 고객 필터를 조정하면 요약과 내보내기를 확인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste a data ou o filtro de cliente para ver o resumo e exportar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените фильтр по дате или клиенту, чтобы увидеть сводку и экспортировать данные."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh bộ lọc ngày hoặc khách hàng để xem tổng hợp và xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
