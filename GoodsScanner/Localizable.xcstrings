            "value": "調整日期或客戶篩選條件後，即可查看彙總與匯出。"
          }
        }
      }
    },
    "Aim at the box top or a side, keep some floor around it": {
      "comment": "ScanSession",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Oberseite oder Seite des Kartons zielen, etwas Boden rundherum im Bild lassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta a la parte superior o a un lateral de la caja y deja algo de suelo alrededor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visez le dessus ou un côté du carton, en laissant un peu de sol autour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "箱の上面または側面に向け、周囲に床が映るようにしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상자 윗면 또는 옆면을 향하고, 주변에 바닥이 보이게 하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte para o topo ou um lado da caixa, deixando um pouco de chão ao redor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите на верх или бок коробки, оставьте вокруг немного пола"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng vào mặt trên hoặc một mặt bên của thùng, chừa một ít sàn xung quanh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对准箱顶或侧面，周围留出地面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對準箱頂或側面，周圍留出地面"
          }
        }
      }
    },
