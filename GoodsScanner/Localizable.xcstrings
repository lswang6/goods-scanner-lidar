    "Point your iPhone at the box until the frame locks on. iPhones with LiDAR measure with LiDAR; other iPhones use the camera.": {
      "comment": "OnboardingView",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richten Sie Ihr iPhone auf den Karton, bis der Rahmen einrastet. iPhones mit LiDAR messen mit LiDAR, andere iPhones nutzen die Kamera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta tu iPhone a la caja hasta que el marco se fije. Los iPhone con LiDAR miden con LiDAR; los demás usan la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visez le carton avec votre iPhone jusqu’à ce que le cadre se verrouille. Les iPhone avec LiDAR mesurent avec le LiDAR ; les autres utilisent la caméra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームがロックされるまで、iPhone を箱に向けてください。LiDAR 搭載の iPhone は LiDAR で、それ以外の iPhone はカメラで測定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임이 고정될 때까지 iPhone을 상자로 향하세요. LiDAR가 있는 iPhone은 LiDAR로, 그 외 iPhone은 카메라로 측정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte o iPhone para a caixa até o contorno travar. iPhones com LiDAR medem com LiDAR; os demais usam a câmera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите iPhone на коробку, пока рамка не зафиксируется. iPhone с LiDAR измеряют с помощью LiDAR, остальные используют камеру."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng iPhone vào thùng cho đến khi khung được khóa. iPhone có LiDAR đo bằng LiDAR; các iPhone khác dùng camera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
