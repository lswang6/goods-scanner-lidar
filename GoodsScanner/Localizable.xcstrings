    "Scan a box of known size. If each side reads 1 cm too large, enter 1. Positive values are subtracted.": {
      "comment": "SettingsView",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen Sie einen Karton mit bekannter Größe. Wird jede Seite 1 cm zu groß gemessen, geben Sie 1 ein. Positive Werte werden abgezogen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea una caja de tamaño conocido. Si cada lado marca 1 cm de más, introduce 1. Los valores positivos se restan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez un carton de taille connue. Si chaque côté est trop grand de 1 cm, saisissez 1. Les valeurs positives sont soustraites."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズが既知の箱をスキャンします。各辺が 1 cm 大きく測定される場合は 1 と入力してください。正の値は差し引かれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기를 아는 상자를 스캔하세요. 각 면이 1 cm 크게 측정되면 1을 입력하세요. 양수 값은 차감됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie uma caixa de tamanho conhecido. Se cada lado medir 1 cm a mais, insira 1. Valores positivos são subtraídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте коробку известного размера. Если каждая сторона завышена на 1 cm, введите 1. Положительные значения вычитаются."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét một thùng có kích thước đã biết. Nếu mỗi cạnh đo lớn hơn 1 cm, hãy nhập 1. Giá trị dương sẽ được trừ đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用已知尺寸的纸箱扫描，若每边偏大 1cm 则填 1。正数表示扣减。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以已知尺寸的紙箱進行掃描。若每邊測得偏大 1 cm，請輸入 1。正數表示扣除。"
          }
        }
