    "Locked on a side, walk around the box": {
      "comment": "ScanSession",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seite erfasst, den Karton umrunden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijado en un lateral, rodea la caja"
          }
